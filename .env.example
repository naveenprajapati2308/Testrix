# Testrix — root environment variables. Copy to `.env` (gitignored) and fill in real values
# before running `docker compose up -d --build` from the repo root.
#
# Generate a strong random value for any secret below with, e.g.:
#   openssl rand -base64 32

# --- Shared MySQL (platform/docker-compose.yml) ---
# Root password for the shared testrix-mysql container. Required — no insecure fallback.
MYSQL_ROOT_PASSWORD=

# --- platform auth/security (testrix-platform-backend) ---
# Only this service issues tokens and sends email; every product validates tokens locally with
# the same secret. Required — startup fails without it. Rotating it logs everyone out.
PORTAL_JWT_SECRET=
# Password for the seeded Super Admin account, applied only the first time that account is
# created (a database that already has the account is unaffected).
PORTAL_SUPERADMIN_SEED_PASSWORD=
# The one Super Admin identity, platform-wide. Required — no hardcoded default. DataSeeder
# uses this both to seed a fresh install and to self-heal an existing account's username/
# email if they ever drift from this value (e.g. after changing it here).
PORTAL_SUPERADMIN_EMAIL=
# Shared secret for service-to-service calls: the execution-manager/runner calling automation's
# execution-event webhook, and api-testing calling the platform's internal report-mail endpoint.
# Required — no insecure fallback.
PORTAL_EVENTS_API_KEY=

# Brute-force guard on the unauthenticated credential endpoints (login, refresh, password reset,
# workspace-request OTP). Nothing is ever blocked permanently — passing a limit starts a hold that
# expires on its own. Defaults: 20 failed attempts on one account pauses it for 1 hour; 40
# attempts from one IP pauses that device for 1 day. Set a max-attempts to 0 to disable that tier.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=20
AUTH_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_ACCOUNT_LOCKOUT_SECONDS=3600
AUTH_RATE_LIMIT_IP_ATTEMPTS=40
AUTH_RATE_LIMIT_IP_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_IP_LOCKOUT_SECONDS=86400

# --- api-testing ---
# AES-256-GCM key (base64, 32 bytes) used to encrypt stored collection credentials at rest.
# Required — no insecure fallback. Changing this value makes every already-encrypted
# credential permanently undecryptable; only change it as part of a deliberate, planned
# re-encryption migration, never casually.
APITESTING_ENCRYPTION_KEY=

# --- SMTP (email sending, testrix-platform-backend) ---
# Used for every outbound email platform-wide (login/OTP codes, workspace-approval notices).
# Leave SMTP_USER blank to keep sending in console-only mode (emails are logged, not sent) —
# MailService falls back to this automatically whenever no SMTP username is configured.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASS=a 16-char Gmail "App Password" (not your normal account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display name recipients see as the sender; the address itself still has to be SMTP_USER
# since Gmail (and most relays) reject a From address that isn't the authenticated account.
PORTAL_MAIL_FROM_NAME=Testrix

# --- Automation module framework source ---
# Host paths to the two external test-framework repos (MPHIDB / playwright-js), bind-mounted
# into the automation-portal backend and automation-framework-runner containers at runtime.
# Point these at wherever those repos are checked out on the machine/CI running this compose
# project.
AUTOMATION_FRAMEWORK_REPO_PATH=
AUTOMATION_PLAYWRIGHT_PATH=

# --- CORS (automation-portal, performance-testing, genai) ---
# Comma-separated browser origins allowed to call a backend's port directly, bypassing the
# gateway. Safe to leave unset for local dev (falls back to the usual localhost origins) —
# add the real production domain here once one exists, e.g.:
# CORS_ALLOWED_ORIGINS=https://testrix.in,http://localhost:15000
CORS_ALLOWED_ORIGINS=

# --- genai (products/genai/service/.env — its own file, not this one) ---
# GROQ_API_KEY=
# TAVILY_API_KEY=
